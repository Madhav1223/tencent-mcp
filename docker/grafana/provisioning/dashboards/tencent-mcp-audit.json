        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "limit": 10
        },
        "pieType": "donut",
        "displayLabels": ["value", "percent"]
      },
      "targets": [
        {
          "expr": "topk(10, sum by (service) (count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\", outcome=~\"$outcome\"}[$__range])))",
