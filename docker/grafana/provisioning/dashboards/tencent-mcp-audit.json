{
  "uid": "tencent-mcp-audit",
  "title": "Tencent MCP - Operations",
  "description": "A live operational view of Tencent MCP traffic, safety decisions, WeData failures, and application errors.",
  "tags": ["tencent-mcp", "operations", "audit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "15s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"tencent-mcp-audit\"}, service)",
        "label": "Service",
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      },
      {
        "name": "outcome",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"tencent-mcp-audit\"}, outcome)",
        "label": "Outcome",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "Navigation",
      "description": "PowerBI-style Previous / Next",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false
        },
        "content": "<div style=\"display:flex;justify-content:space-between;align-items:center;padding:4px 8px;background:#1f1f1f;border-radius:6px;\">\n<span style=\"color:#888\">\u25c0 Previous \u2014 <em>Operations is first page</em></span>\n<a href=\"/d/tencent-mcp-report/tencent-mcp-report\" style=\"background:#3274d9;color:white;padding:6px 14px;border-radius:4px;text-decoration:none;font-weight:600\">Next \u2192 Report</a>\n</div>"
      },
      "datasource": null,
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "API calls",
      "description": "All audited Tencent Cloud API calls in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\", outcome=~\"$outcome\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
