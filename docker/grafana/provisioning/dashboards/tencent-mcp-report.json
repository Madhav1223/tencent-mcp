      "targets": [
        {
          "expr": "topk(10, sum by (service) (count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"}[$__range])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
