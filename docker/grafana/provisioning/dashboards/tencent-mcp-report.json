{
  "uid": "tencent-mcp-report",
  "title": "Tencent MCP - Report",
  "description": "Executive report: SLO/SLI, latency, hotspots and RCA - complements the Operations audit dashboard.",
  "tags": ["tencent-mcp", "report", "slo", "rca"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"tencent-mcp-audit\"}, service)",
        "label": "Service",
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      },
      {
        "name": "outcome",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({job=\"tencent-mcp-audit\"}, outcome)",
        "label": "Outcome",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 199,
      "type": "text",
      "title": "Navigation",
      "description": "PowerBI-style Previous / Next",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false
        },
        "content": "<div style=\"display:flex;justify-content:space-between;align-items:center;padding:4px 8px;background:#1f1f1f;border-radius:6px;\">\n<a href=\"/d/tencent-mcp-audit/tencent-mcp-audit\" style=\"background:#3274d9;color:white;padding:6px 14px;border-radius:4px;text-decoration:none;font-weight:600\">\u2190 Previous \u2022 Operations</a>\n<span style=\"color:#888\">Report is last page \u2014 Next loops to Operations \u25b6</span>\n<a href=\"/d/tencent-mcp-audit/tencent-mcp-audit\" style=\"background:#2d2d2d;color:white;padding:6px 14px;border-radius:4px;text-decoration:none;border:1px solid #555\">Next \u2192 Operations</a>\n</div>"
      },
      "datasource": null,
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Total calls (period)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 102,
      "type": "gauge",
      "title": "Success rate (SLO)",
      "description": "success / total. Green >=99%, yellow >=95%.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "(sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\", outcome=\"success\"}[$__range])) / sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"}[$__range]))) * 100",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Error + Failed rate",
      "description": "(error + failed) / total",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "((sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\", outcome=\"error\"}[$__range])) + sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\", outcome=\"failed\"}[$__range]))) / sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"}[$__range]))) * 100",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Blocked rate",
      "description": "blocked / total",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "(sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\", outcome=\"blocked\"}[$__range])) / sum(count_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"}[$__range]))) * 100",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Avg latency",
      "description": "Mean source.duration_ms across period (ms).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "avg_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"} | json | unwrap source_duration_ms [$__range])",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 106,
      "type": "stat",
      "title": "P95 latency (est.)",
      "description": "quantile 0.95 of duration_ms - tail latency.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2000
              },
              {
                "color": "red",
                "value": 8000
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {job=\"tencent-mcp-audit\", service=~\"$service\"} | json | unwrap source_duration_ms [$__range])",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "Latency over time - avg and p95",
      "description": "avg and p95 of source.duration_ms; spikes correlate with error/failed.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        }
      },
      "targets": [
        {
          "expr": "avg_over_time({job=\"tencent-mcp-audit\", service=~\"$service\"} | json | unwrap source_duration_ms [$__interval])",
          "legendFormat": "avg",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "range": true
        },
        {
          "expr": "quantile_over_time(0.95, {job=\"tencent-mcp-audit\", service=~\"$service\"} | json | unwrap source_duration_ms [$__interval])",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "range": true
        }
      ]
    },
    {
      "id": 120,
